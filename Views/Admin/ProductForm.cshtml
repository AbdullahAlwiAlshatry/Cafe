@model Product
@{
    var editing = Model.Id > 0;
    ViewData["Title"] = editing ? "تعديل مشروب" : "إضافة مشروب";
}
<div class="form-shell">
    <h2>@ViewData["Title"]</h2>
    <p class="muted">@(editing ? "عدّل البيانات ثم احفظ. اترك حقول الصور فارغة للإبقاء على الصور الحالية." : "أدخل بيانات المشروب كما ستظهر للعملاء.")</p>
    <form method="post" enctype="multipart/form-data" action="@(editing ? "/Admin/Edit/" + Model.Id : "/Admin/Create")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <label for="Name">اسم المشروب</label>
        <input id="Name" name="Name" value="@Model.Name" class="form-control" placeholder="مثال: كابتشينو" required maxlength="100" />

        <label for="Description">الوصف</label>
        <textarea id="Description" name="Description" class="form-control" rows="4" placeholder="المكونات، الحجم، أو ما يميّزه">@Model.Description</textarea>

        <label for="Price">السعر</label>
        <input id="Price" name="Price" type="number" step="0.01" min="0" value="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control" placeholder="0.00" required dir="ltr" />

        <label for="mainImage">الصورة الرئيسية</label>
        <input id="mainImage" name="mainImage" type="file" accept="image/*" class="form-control" />
        @if (editing && !string.IsNullOrEmpty(Model.MainImage))
        {
            <div class="current-image"><img src="@Model.MainImage" alt="" /> الصورة الحالية</div>
        }

        <label for="gallery">صور إضافية (يمكن اختيار أكثر من صورة)</label>
        <input id="gallery" name="gallery" type="file" accept="image/*" multiple class="form-control" />

        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="IsAvailable" name="IsAvailable" value="true" checked="@(editing ? Model.IsAvailable : true)" />
            <label class="form-check-label" for="IsAvailable">متاح للطلب في القائمة</label>
        </div>

        <div class="stack mt-4">
            <button class="btn-primary-cafe w-100" type="submit">@(editing ? "حفظ التعديلات" : "إضافة المشروب")</button>
            <a href="/Admin" class="btn-outline-cafe w-100">إلغاء</a>
        </div>
    </form>
</div>
