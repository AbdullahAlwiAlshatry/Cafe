@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isAdmin = string.Equals(controller, "Admin", StringComparison.OrdinalIgnoreCase);
    var isSignedIn = User?.Identity?.IsAuthenticated == true;
    var config = Context.RequestServices.GetService(typeof(Microsoft.Extensions.Configuration.IConfiguration)) as Microsoft.Extensions.Configuration.IConfiguration;
    var waPhone = config?["WhatsApp:Phone"];
    var waLink = string.IsNullOrWhiteSpace(waPhone) ? "#" : "https://wa.me/" + waPhone;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] | رَشفة</title>
    <meta name="description" content="رَشفة — اطلب قهوتك ومشروباتك المفضلة أونلاين، تُحضَّر طازجة وتصلك إلى موقعك." />
    <meta name="theme-color" content="#8E1F2F" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true">
    <link href="~/favicon.ico" rel="icon" type="image/x-icon">
</head>
<body class="@(isAdmin ? "admin-shell" : "is-customer")">
    <header class="site-header">
        <div class="wrap header-row">
            <a class="brand" href="@(isAdmin && isSignedIn ? "/Admin" : "/")" aria-label="رَشفة — الرئيسية">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h13v4a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6v-4Z"/><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3.5c-.8 1 .8 2 0 3M12 3.5c-.8 1 .8 2 0 3"/></svg>
                </span>
                <span class="brand-name">رَشفة</span>
            </a>

            @if (isAdmin)
            {
                <nav class="main-nav" aria-label="قائمة الإدارة">
                    @if (isSignedIn)
                    {
                        <a href="/Admin">المشروبات</a>
                        <a href="/Admin/Orders">الطلبات</a>
                    }
                    <a href="/" target="_blank" rel="noopener">عرض المتجر</a>
                </nav>
            }
            else
            {
                <nav class="main-nav" aria-label="القائمة الرئيسية">
                    <a href="/#menu">القائمة</a>
                    <a href="/#how">طريقة الطلب</a>
                    <a href="/Home/MenuPdf">القائمة PDF</a>
                </nav>
                <button type="button" class="header-cart" data-open-cart aria-label="فتح السلة">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
                    <span>السلة</span>
                    <b class="cart-count">0</b>
                </button>
            }
        </div>
    </header>

    <main class="page">
        <div class="wrap">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="wrap footer-row">
            <span class="brand-name">رَشفة</span>
            @if (!isAdmin)
            {
                <nav class="footer-links" aria-label="روابط سريعة">
                    <a href="/#menu">القائمة</a>
                    <a href="/Home/MenuPdf">تحميل القائمة</a>
                    <a href="@waLink" target="_blank" rel="noopener">واتساب</a>
                    <a href="/Admin/Login">دخول الإدارة</a>
                </nav>
            }
            <small>© @DateTime.Now.Year رَشفة. جميع الحقوق محفوظة.</small>
        </div>
    </footer>

    @if (!isAdmin)
    {
        <div class="cart-backdrop" id="cartBackdrop"></div>
        <aside class="cart-panel" id="cartPanel" aria-label="سلة الطلبات" aria-hidden="true">
            <div class="cart-head">
                <h3>سلة طلباتك</h3>
                <button type="button" class="icon-btn" data-close-cart aria-label="إغلاق السلة">×</button>
            </div>
            <div class="cart-body" id="cartItems"></div>
            <div class="cart-foot" id="cartFoot">
                <div class="cart-total"><span>الإجمالي</span><strong id="cartTotal">0.00</strong></div>
                <a href="/Order/Review" class="btn-primary-cafe w-100" id="cartCheckout">مراجعة الطلب</a>
            </div>
        </aside>

        <nav class="bottom-nav" aria-label="تنقل سريع">
            <a href="/#menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
                القائمة
            </a>
            <button type="button" data-open-cart>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
                السلة
                <b class="cart-count">0</b>
            </button>
            <a href="@waLink" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19l-4 1Z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2L9 9.5Z"/></svg>
                واتساب
            </a>
        </nav>
    }

    <div class="toast-holder" id="toastHolder" role="status" aria-live="polite"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
